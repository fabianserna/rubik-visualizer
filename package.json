{
  "name": "rubik-visualizer",
  "version": "1.0.0",
  "description": "Rubik Studio Visualizer plugin for Obsidian (3x3 and 4x4 interactive 3D/2D cube visualizer)",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "rubik",
    "cubing",
    "twisty",
    "3d"
  ],
  "author": "Fabian Serna (FabiDev<3)",
  "license": "MIT",
  "dependencies": {
    "cubing": "0.54.5"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "esbuild": "0.20.2",
    "obsidian": "1.14.4",
    "tslib": "2.8.1",
    "typescript": "5.9.3"
  }
}
